# Contact link — shown as the mailto: call-to-action in the contact section.
# These are read at build time and are public (they ship in the client bundle).
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Only needed to preview a GitHub Pages *project* site locally, e.g. /pmr-portefolio.
# The deploy workflow sets this automatically; leave it unset for a user/org site
# (<user>.github.io) or a custom domain.
# NEXT_PUBLIC_BASE_PATH=/pmr-portefolio
