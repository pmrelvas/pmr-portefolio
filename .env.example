# Contact form (Resend) — server-side only. Never prefix these with NEXT_PUBLIC_.
# Get a sending-only API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact messages are delivered.
CONTACT_TO_EMAIL=you@example.com

# Verified sender. Use "onboarding@resend.dev" while testing without a domain.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
